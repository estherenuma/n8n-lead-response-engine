eft:3px solid #d4d4ce;font-size:15px;line-height:1.6;white-space:pre-line;\">{{ $('Normalise the lead').first().json.lead_message }}</div>\n\n  <div style=\"margin-top:20px;padding-top:16px;border-top:1px solid #e6e6e2;font-size:13px;color:#8a8a85;\">\n    Ava replied automatically at {{ $now.toFormat('HH:mm') }}. Lead ID {{ $('Normalise the lead').first().json.lead_id }}.\n  </div>\n\n</div>",
